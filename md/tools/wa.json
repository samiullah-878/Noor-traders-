true,"m_userPromptTitle":"💬 WhatsApp — bina save","m_userPromptMessage":"Number likhein ya paste karein (0300… ya +92…). OK = WhatsApp mein chat khulegi.","m_userPromptShowCancel":true,"m_userPromptStopAfterCancel":false,"m_userPromptEmptyAtStart":true},{"m_classType":"JavaAction","m_SIGUID":0,"scriptText":"try {\n  String s = magicText.evaluateString(\"{\" + \"lv=num}\");\n  if (s == null) s = \"\";\n  s = s.trim();\n  if (s.length() == 0) return \"\";\n  java.util.regex.Matcher m = java.util.regex.Pattern.compile(\"([+]|00)?[0-9][0-9 ().-]*[0-9]\").matcher(s);\n  String t = null;\n  while (m.find()) { String g = m.group(); if (g.replaceAll(\"[^0-9]\", \"\").length() >= 10) { t = g; break; } }\n  if (t == null) return \"x\";\n  boolean intl = t.startsWith(\"+\") || t.startsWith(\"00\");\n  String d = t.replaceAll(\"[^0-9]\", \"\");\n  if (t.startsWith(\"00\")) d = d.substring(2);\n  if (!intl) {\n    if (d.startsWith(\"0\")) d = \"92\" + d.substring(1);\n    else if (d.length() == 10 && d.startsWith(\"3\")) d = \"92\" + d;\n  }\n  if (d.startsWith(\"920\") && d.length() == 13) d = \"92\" + d.substring(3);\n  if (d.length() < 10 || d.length() > 15) return \"x\";\n  return d;\n} catch (Throwable e) { return \"x\"; }","blockNextAction":true,"responseVariableName":"wn","runInBackgroundThread":false},{"m_classType":"IfConditionAction","m_SIGUID":0,"m_constraintList":[{"m_classType":"MacroDroidVariableConstraint","m_SIGUID":0,"m_variable":{"m_name":"wn","m_type":2,"isLocalVar":true},"m_stringValue":"x","m_stringComparisonType":0,"m_stringEqual":true}]},{"m_classType":"ToastAction","m_SIGUID":0,"m_messageText":"❌ Number samajh nahi aaya — dobara 💬 dabayein","m_duration":2,"m_position":1,"m_backgroundColor":-14606047,"m_textColor":-1,"useTextOnly":true,"cancelPrevious":true},{"m_classType":"ElseAction","m_SIGUID":0},{"m_classType":"IfConditionAction","m_SIGUID":0,"m_constraintList":[{"m_classType":"MacroDroidVariableConstraint","m_SIGUID":0,"m_variable":{"m_name":"wn","m_t