rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Match the explicitly provisioned owner identities in auth-controller.js.
    // An arbitrary Firebase email account must never gain business-owner access.
    function isOwner() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'admin@nt-traders.firebaseapp.com',
          'owner@nttraders.local',
          'hp6235@gmail.com'
        ];
    }

    function isStaff() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function sessionPhone() {
      return get(/databases/$(database)/documents/businesses/noor-traders/staffSessions/$(request.auth.uid)).data.phone;
    }

    function enabledStaffAccount(phone) {
      let account = get(/databases/$(database)/documents/businesses/noor-traders/staffAccounts/$(phone)).data;
      return (!('active' in account) || account.active == true)
        && (!('loginEnabled' in account) || account.loginEnabled == true);
    }

    function validStaffSession() {
      return isStaff() && enabledStaffAccount(sessionPhone());
    }

    // Existing owner business data: owner only.
    match /businesses/noor-traders/{collectionName}/{docId} {
      allow read, write: if isOwner();
    }

    // Staff can read only the account bound to their own server session.
    match /businesses/noor-traders/staffAccounts/{phone} {
      allow get: if isOwner()
        || (isStaff() && phone == sessionPhone()
          && (!('active' in resource.data) || resource.data.active == true)
          && (!('loginEnabled' in resource.data) || resource.data.loginEnabled == true));
      allow list, create, update, delete: if isOwner();
    }

    // A phone-as-password login creates one binding for a fresh anonymous UID.
    // It cannot rebind that UID to another employee later.
    match /businesses/noor-traders/staffSessions/{uid} {
      allow create: if isStaff()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^03[0-9]{9}$')
        && enabledStaffAccount(request.resource.data.phone);
      allow update: if isOwner();
      allow get: if isOwner() || (isStaff() && request.auth.uid == uid);
      allow delete, list: if isOwner();
    }

    // The staff portal needs its attendance policy after authentication.
    match /businesses/noor-traders/staffConfig/{configId} {
      allow get: if isOwner() || (configId == 'main' && validStaffSession());
      allow list, create, update, delete: if isOwner();
    }

    // Employee can only access attendance rows for the phone attached to their own session.
    match /businesses/noor-traders/staffAttendance/{attendanceId} {
      allow read: if isOwner()
        || (validStaffSession() && resource.data.phone == sessionPhone());

      allow create: if isOwner()
        || (validStaffSession() && request.resource.data.phone == sessionPhone());

      allow update: if isOwner()
        || (validStaffSession()
          && resource.data.phone == sessionPhone()
          && request.resource.data.phone == sessionPhone());

      allow delete: if isOwner();
    }

    // Staff v104: owner reviews; staff can only create/read their own requests.
    match /businesses/noor-traders/staffRequests/{requestId} {
      allow read: if isOwner() || (validStaffSession() && resource.data.phone == sessionPhone());
      allow create: if validStaffSession()
        && request.resource.data.keys().hasOnly(['phone','kind','date','to','checkIn','checkOut','reason','status','createdAt','by'])
        && request.resource.data.phone == sessionPhone()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.kind in ['leave','correction','suggestion']
        && request.resource.data.status == 'pending'
        && request.resource.data.date is string && request.resource.data.to is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.to.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.to >= request.resource.data.date
        && request.resource.data.checkIn is string && request.resource.data.checkOut is string
        && request.resource.data.checkIn.size() <= 5 && request.resource.data.checkOut.size() <= 5
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt is number;
      allow update, delete: if isOwner();
    }
    match /businesses/noor-traders/staffSchedules/{phone} {
      allow read: if isOwner() || (validStaffSession() && resource.data.phone == sessionPhone());
      allow write: if isOwner();
    }
    match /businesses/noor-traders/staffPayroll/{payrollId} {
      allow read: if isOwner() || (validStaffSession() && resource.data.phone == sessionPhone());
      allow write: if isOwner();
    }
    match /businesses/noor-traders/staffAudit/{eventId} {
      allow read, create: if isOwner();
    }

    match /businesses/noor-traders/staffTasks/{taskId} {
      allow read: if isOwner()
        || (validStaffSession() && resource.data.phone == sessionPhone());
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        validStaffSession()
        && resource.data.phone == sessionPhone()
        && resource.data.get('status', 'assigned') in ['assigned', 'changes_requested']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'revision', 'submissionId', 'photoIds', 'staffNote', 'submittedBy', 'submittedAt'
        ])
        && request.resource.data.status == 'submitted'
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && request.resource.data.submissionId is string
        && request.resource.data.submissionId.matches('^[A-Za-z0-9_-]{8,80}$')
        && request.resource.data.submissionId != resource.data.get('submissionId', '')
        && request.resource.data.photoIds is list
        && request.resource.data.photoIds.size() >= 1
        && request.resource.data.photoIds.size() <= 8
        && request.resource.data.photoIds.toSet().size() == request.resource.data.photoIds.size()
        && request.resource.data.staffNote is string
        && request.resource.data.staffNote.size() <= 2000
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedAt is number
        && resource.data.get('points', 0) == 0
      );
      match /taskPhotos/{photoId} {
        function task() {
          return get(/databases/$(database)/documents/businesses/noor-traders/staffTasks/$(taskId)).data;
        }
        function nextTask() {
          return getAfter(/databases/$(database)/documents/businesses/noor-traders/staffTasks/$(taskId)).data;
        }
        allow read: if isOwner() || (validStaffSession() && task().phone == sessionPhone());
        allow create: if isOwner() || (
          validStaffSession() && task().phone == sessionPhone()
          && task().get('status', 'assigned') in ['assigned', 'changes_requested']
          && nextTask().status == 'submitted'
          && nextTask().revision == task().get('revision', 0) + 1
          && nextTask().submittedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['taskId', 'submissionId', 'dataUrl', 'uploadedBy', 'createdAt'])
          && request.resource.data.taskId == taskId
          && request.resource.data.submissionId == nextTask().submissionId
          && photoId in nextTask().photoIds
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.createdAt is number
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 280000
          && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')
        );
        allow update, delete: if isOwner();
      }
    }
  }
}
