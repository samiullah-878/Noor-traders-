@echo off
title BARCODE-DOCTOR (label print ki jaanch)
cd /d C:\khata-sync 2>nul || (echo C:\khata-sync folder nahi mila & pause & exit /b)
where node >nul 2>&1 || (echo Node.js nahi mila - nodejs.org se LTS install karein & pause & exit /b)
echo ================================================
echo   BARCODE-DOCTOR : label print ki poori jaanch
echo ================================================
powershell -NoP -C "[IO.File]::WriteAllBytes('C:\khata-sync\barcode-doctor.js',[Convert]::FromBase64String(''))"
node barcode-doctor.js
echo.
echo ------------------------------------------------
echo   T = test label chhapo
echo   C = calibrate - roll badla ho to
echo   S = label script chalu karo
echo   N = bas, band
echo ------------------------------------------------
choice /c TCSN /n /m "Kya karein? T / C / S / N : "
if errorlevel 4 goto end
if errorlevel 3 goto start
if errorlevel 2 goto cal
if errorlevel 1 goto test
:test
node label-print.js --test
goto end
:cal
node label-print.js --calibrate
goto end
:start
start "label-auto" /min cmd /c label-auto.bat
echo label-print chalu kar di - chhoti window mein chal rahi hai.
:end
echo.
pause
